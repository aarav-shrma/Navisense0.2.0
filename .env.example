# ═══════════════════════════════════════════════════════════
#  NaviSense · Environment Variable Template
#  Copy to .env and fill in real values. NEVER commit .env.
# ═══════════════════════════════════════════════════════════

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ─── API Gateway ────────────────────────────────────────────
API_GATEWAY_PORT=3001
JWT_SECRET=<a-long-random-secret-min-32-chars>
AI_SERVICE_URL=http://ai-service:8000   # docker-compose internal hostname

# ─── AI Service ─────────────────────────────────────────────
AI_SERVICE_PORT=8000
# CUDA: set to "cuda" for RTX 3050, "cpu" for CPU-only fallback
DEVICE=cuda
YOLO_MODEL_PATH=models/weights/yolov8n.pt
FACENET_MODEL_PATH=models/weights/facenet.pt
TESSERACT_DATA_PATH=/usr/share/tesseract-ocr/5/tessdata

# ─── Mobile App ─────────────────────────────────────────────
EXPO_PUBLIC_API_GATEWAY_URL=http://localhost:3001
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ─── Feature Flags ──────────────────────────────────────────
ENABLE_GPU_ACCELERATION=true
LOG_LEVEL=info                          # debug | info | warn | error
